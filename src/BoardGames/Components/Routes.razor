@inject IEnumerable<GameDescriptor> Games
@* Every game module contributes its routes through the assembly in its GameDescriptor. *@
<Router AppAssembly="typeof(Program).Assembly" AdditionalAssemblies="Games.Select(g => g.Assembly).Distinct()" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
